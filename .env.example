# Copy to .env.local for local development. Never commit real secrets.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key (safe to expose — Row Level Security protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Only for project sites (username.github.io/repo). Leave empty locally.
# NEXT_PUBLIC_BASE_PATH=/repo-name
